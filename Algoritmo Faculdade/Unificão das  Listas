    ////Funcoes Questao 1
    int horas(int seg){return seg/3600;}
    int minutos(int seg){return (seg%3600)/60;}
    int segundos(int seg){return seg%60;}
    ////
    ////Funcoes Questao 2
    int verificador(int numPouI){
        if (numPouI%2==0){
        return 1;
        }
        else {
            return 2;
        }
    }
    ////
    ////Funcoes Questao 3
    int maior(int n1, int n2, int n3){
        int maiorn = n1;
        if (n2>maiorn) {maiorn = n2;}
        if (n3>maiorn) {maiorn = n3;}
        return maiorn;
    }
    int menor(int n1, int n2, int n3){
        int menorn = n1;
        if (n2<menorn) {menorn = n2;}
        if (n3<menorn) {menorn = n3;}
        return menorn;
    }
    int medio(int n1, int n2, int n3){
        return n1+n2+n3;
    }
